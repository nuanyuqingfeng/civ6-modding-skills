 "Q-CityGetDistrictsGetDistrictGetLocation": {
  "id": "Q-CityGetDistrictsGetDistrictGetLocation",
  "type": "QUERY",
  "table": "City",
  "functionA": "GetDistricts",
  "invoke": "Colon (Instance)",
  "availability": "Both",
  "functionB": "GetDistrict",
  "functionC": "GetLocation",
  "displayName": "City:GetDistricts():GetDistrict():GetLocation()",
  "notes": [
   "[作用] 获取城市指定区域的所在位置坐标",
